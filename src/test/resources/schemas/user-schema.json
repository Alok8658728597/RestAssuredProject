{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"required": [
		"id",
		"name",
		"data"
	],
	"properties": {
		"id": {
			"type": "string"
		},
		"name": {
			"type": "string"
		},
		"data": {
			"type": "object",
			"required": [
				"year",
				"price",
				"CPU model",
				"Hard disk size"
			],
			"properties": {
				"year": {
					"type": "integer"
				},
				"price": {
					"type": "number"
				},
				"CPU model": {
					"type": "string"
				},
				"Hard disk size": {
					"type": "string"
				}
			}
		}
	}
}